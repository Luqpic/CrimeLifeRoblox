-- Tests for Blaster.Utility.shoulderMath (2026-11-20): the shoulder camera's wall clamp and pitch, and the server's
-- checks on a reported aim pitch (a finite number, clamped, at most one per interval).
return function(t)
	local shoulderMath = require(game:GetService("ReplicatedStorage").Blaster.Utility.shoulderMath)
	local expect = t.expect
	local MAX = math.rad(70)

	t.test("the shoulder keeps its side and never reaches past the wall", function()
		expect.near(shoulderMath.clampSide(1.75, 5), 1.75, 1e-9)
		expect.near(shoulderMath.clampSide(1.75, 0.6), 0.6, 1e-9)
		expect.near(shoulderMath.clampSide(-1.75, 0.6), -0.6, 1e-9)
		expect.near(shoulderMath.clampSide(-1.75, -2), 0, 1e-9)
	end)
	t.test("the pitch follows the look and stops at 70 degrees", function()
		expect.near(shoulderMath.pitchOf(0, MAX), 0, 1e-9)
		expect.near(shoulderMath.pitchOf(math.sin(math.rad(30)), MAX), math.rad(30), 1e-6)
		expect.near(shoulderMath.pitchOf(1, MAX), MAX, 1e-9)
		expect.near(shoulderMath.pitchOf(-1.5, MAX), -MAX, 1e-9)
	end)
	t.test("the server takes only a finite number, clamped", function()
		expect.near(shoulderMath.acceptPitch(0.5, MAX), 0.5, 1e-9)
		expect.near(shoulderMath.acceptPitch(10, MAX), MAX, 1e-9)
		expect.near(shoulderMath.acceptPitch(-10, MAX), -MAX, 1e-9)
		expect.equal(shoulderMath.acceptPitch(0 / 0, MAX), nil)
		expect.equal(shoulderMath.acceptPitch(math.huge, MAX), nil)
		expect.equal(shoulderMath.acceptPitch(-math.huge, MAX), nil)
		expect.equal(shoulderMath.acceptPitch("0.5", MAX), nil)
		expect.equal(shoulderMath.acceptPitch(nil, MAX), nil)
		expect.equal(shoulderMath.acceptPitch(Vector3.zero, MAX), nil)
	end)
	t.test("reports are taken at most once per interval", function()
		expect.truthy(shoulderMath.due(nil, 5, 0.08))
		expect.truthy(shoulderMath.due(5, 5.08, 0.08))
		expect.equal(shoulderMath.due(5, 5.05, 0.08), false)
	end)
	t.test("the blend eases from 0 to 1 and holds outside", function()
		expect.near(shoulderMath.smooth(-1), 0, 1e-9)
		expect.near(shoulderMath.smooth(0.5), 0.5, 1e-9)
		expect.near(shoulderMath.smooth(2), 1, 1e-9)
	end)
end
